<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Anime Character Creator - VEQZAI</title>
    <link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@400;500;600;700&family=Barlow:ital,wght@0,300;0,400;0,500;0,600;1,300&display=swap" rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
  <link rel="stylesheet" href="../../assets/css/character-making.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
    <div class="container">
        <!-- Header -->
        <div class="header">
            <h1>♥ ANIME CHARACTER CREATOR ♥</h1>
            <p>Craft your unique anime hero for VEQZAI</p>
        </div>

        <!-- Main Layout -->
        <div class="main-layout">
            <!-- Left: Character Preview -->
            <div class="preview-panel">
                <div class="preview-title">Character Preview</div>
                <div id="characterPreview"></div>
                <div class="preview-info">
                    <div class="preview-info-item">
                        <span class="info-label">Gender:</span>
                        <span class="info-value" id="previewGender">Male</span>
                    </div>
                    <div class="preview-info-item">
                        <span class="info-label">Hair:</span>
                        <span class="info-value" id="previewHair">Black</span>
                    </div>
                    <div class="preview-info-item">
                        <span class="info-label">Eyes:</span>
                        <span class="info-value" id="previewEyes">Blue</span>
                    </div>
                    <div class="preview-info-item">
                        <span class="info-label">Skin Tone:</span>
                        <span class="info-value" id="previewSkin">Light</span>
                    </div>
                </div>
            </div>

            <!-- Center: Customization Panel -->
            <div class="customization-panel">
                <div class="customization-title">Customization</div>

                <!-- Basic Appearance -->
                <div class="custom-section">
                    <div class="section-title">Basic Appearance</div>
                    
                    <div class="form-group">
                        <label>Gender</label>
                        <div class="option-grid">
                            <button class="option-btn active" data-gender="male" data-action="update-character" data-field="gender" data-value="male">Male</button>
                            <button class="option-btn" data-gender="female" data-action="update-character" data-field="gender" data-value="female">Female</button>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Body Type</label>
                        <div class="option-grid">
                            <button class="option-btn active" data-body="slim" data-action="update-character" data-field="bodyType" data-value="slim">Slim</button>
                            <button class="option-btn" data-body="athletic" data-action="update-character" data-field="bodyType" data-value="athletic">Athletic</button>
                            <button class="option-btn" data-body="muscular" data-action="update-character" data-field="bodyType" data-value="muscular">Muscular</button>
                            <button class="option-btn" data-body="curvy" data-action="update-character" data-field="bodyType" data-value="curvy">Curvy</button>
                        </div>
                    </div>

                    <div class="slider-group">
                        <label>
                            <span>Height</span>
                            <span id="heightValue">170cm</span>
                        </label>
                        <input type="range" min="150" max="200" value="170" data-action="update-character" data-field="height">
                    </div>

                    <div class="slider-group">
                        <label>
                            <span>Age Appearance</span>
                            <span id="ageValue">20</span>
                        </label>
                        <input type="range" min="16" max="50" value="20" data-action="update-character" data-field="age">
                    </div>
                </div>

                <!-- Skin & Face -->
                <div class="custom-section">
                    <div class="section-title">Skin & Face</div>

                    <div class="form-group">
                        <label>Skin Tone</label>
                        <div class="color-picker-group">
                            <div class="color-option swatch-f4a460 active" data-color="light" data-action="update-character" data-field="skinTone" data-value="light"></div>
                            <div class="color-option swatch-d2a679" data-color="medium" data-action="update-character" data-field="skinTone" data-value="medium"></div>
                            <div class="color-option swatch-bc8f8f" data-color="tan" data-action="update-character" data-field="skinTone" data-value="tan"></div>
                            <div class="color-option swatch-8b6f47" data-color="dark" data-action="update-character" data-field="skinTone" data-value="dark"></div>
                            <div class="color-option swatch-cd5c5c" data-color="fantasy" data-action="update-character" data-field="skinTone" data-value="fantasy"></div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Face Shape</label>
                        <div class="option-grid">
                            <button class="option-btn active" data-face="oval" data-action="update-character" data-field="faceShape" data-value="oval">Oval</button>
                            <button class="option-btn" data-face="round" data-action="update-character" data-field="faceShape" data-value="round">Round</button>
                            <button class="option-btn" data-face="square" data-action="update-character" data-field="faceShape" data-value="square">Square</button>
                            <button class="option-btn" data-face="heart" data-action="update-character" data-field="faceShape" data-value="heart">Heart</button>
                        </div>
                    </div>
                </div>

                <!-- Eyes -->
                <div class="custom-section">
                    <div class="section-title">Eyes</div>

                    <div class="form-group">
                        <label>Eye Color</label>
                        <div class="color-picker-group">
                            <div class="color-option swatch-4a90e2 active" data-color="blue" data-action="update-character" data-field="eyeColor" data-value="blue"></div>
                            <div class="color-option swatch-7cb342" data-color="green" data-action="update-character" data-field="eyeColor" data-value="green"></div>
                            <div class="color-option swatch-8b4513" data-color="brown" data-action="update-character" data-field="eyeColor" data-value="brown"></div>
                            <div class="color-option swatch-a020f0" data-color="purple" data-action="update-character" data-field="eyeColor" data-value="purple"></div>
                            <div class="color-option swatch-ff1493" data-color="pink" data-action="update-character" data-field="eyeColor" data-value="pink"></div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Eye Shape</label>
                        <div class="option-grid">
                            <button class="option-btn active" data-eyes="anime" data-action="update-character" data-field="eyeShape" data-value="anime">Anime</button>
                            <button class="option-btn" data-eyes="sharp" data-action="update-character" data-field="eyeShape" data-value="sharp">Sharp</button>
                            <button class="option-btn" data-eyes="soft" data-action="update-character" data-field="eyeShape" data-value="soft">Soft</button>
                            <button class="option-btn" data-eyes="large" data-action="update-character" data-field="eyeShape" data-value="large">Large</button>
                        </div>
                    </div>

                    <div class="slider-group">
                        <label>
                            <span>Eye Size</span>
                            <span id="eyeSizeValue">Medium</span>
                        </label>
                        <input type="range" min="1" max="3" value="2" data-action="update-character" data-field="eyeSize">
                    </div>
                </div>

                <!-- Hair -->
                <div class="custom-section">
                    <div class="section-title">Hair</div>

                    <div class="form-group">
                        <label>Hair Style</label>
                        <div class="option-grid">
                            <button class="option-btn active" data-hair="long" data-action="update-character" data-field="hairStyle" data-value="long">Long</button>
                            <button class="option-btn" data-hair="short" data-action="update-character" data-field="hairStyle" data-value="short">Short</button>
                            <button class="option-btn" data-hair="bob" data-action="update-character" data-field="hairStyle" data-value="bob">Bob</button>
                            <button class="option-btn" data-hair="wavy" data-action="update-character" data-field="hairStyle" data-value="wavy">Wavy</button>
                            <button class="option-btn" data-hair="spiky" data-action="update-character" data-field="hairStyle" data-value="spiky">Spiky</button>
                            <button class="option-btn" data-hair="twintails" data-action="update-character" data-field="hairStyle" data-value="twintails">Twin Tails</button>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Hair Color</label>
                        <div class="color-picker-group">
                            <div class="color-option swatch-1a1a1a active" data-color="black" data-action="update-character" data-field="hairColor" data-value="black"></div>
                            <div class="color-option swatch-8b7355" data-color="brown" data-action="update-character" data-field="hairColor" data-value="brown"></div>
                            <div class="color-option swatch-ffd700" data-color="blonde" data-action="update-character" data-field="hairColor" data-value="blonde"></div>
                            <div class="color-option swatch-ff6b6b" data-color="red" data-action="update-character" data-field="hairColor" data-value="red"></div>
                            <div class="color-option swatch-a020f0" data-color="purple" data-action="update-character" data-field="hairColor" data-value="purple"></div>
                            <div class="color-option swatch-00bfff" data-color="cyan" data-action="update-character" data-field="hairColor" data-value="cyan"></div>
                            <div class="color-option swatch-fff" data-color="white" data-action="update-character" data-field="hairColor" data-value="white"></div>
                        </div>
                    </div>
                </div>

                <!-- Facial Features -->
                <div class="custom-section">
                    <div class="section-title">Facial Features</div>

                    <div class="form-group">
                        <label>Eyebrows</label>
                        <div class="option-grid">
                            <button class="option-btn active" data-brow="normal" data-action="update-character" data-field="eyebrows" data-value="normal">Normal</button>
                            <button class="option-btn" data-brow="thick" data-action="update-character" data-field="eyebrows" data-value="thick">Thick</button>
                            <button class="option-btn" data-brow="thin" data-action="update-character" data-field="eyebrows" data-value="thin">Thin</button>
                            <button class="option-btn" data-brow="angular" data-action="update-character" data-field="eyebrows" data-value="angular">Angular</button>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Nose</label>
                        <div class="option-grid">
                            <button class="option-btn active" data-nose="petite" data-action="update-character" data-field="nose" data-value="petite">Petite</button>
                            <button class="option-btn" data-nose="normal" data-action="update-character" data-field="nose" data-value="normal">Normal</button>
                            <button class="option-btn" data-nose="prominent" data-action="update-character" data-field="nose" data-value="prominent">Prominent</button>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Mouth</label>
                        <div class="option-grid">
                            <button class="option-btn active" data-mouth="small" data-action="update-character" data-field="mouth" data-value="small">Small</button>
                            <button class="option-btn" data-mouth="normal" data-action="update-character" data-field="mouth" data-value="normal">Normal</button>
                            <button class="option-btn" data-mouth="wide" data-action="update-character" data-field="mouth" data-value="wide">Wide</button>
                            <button class="option-btn" data-mouth="pouty" data-action="update-character" data-field="mouth" data-value="pouty">Pouty</button>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Facial Markings</label>
                        <div class="option-grid">
                            <button class="option-btn active" data-mark="none" data-action="update-character" data-field="facialMarking" data-value="none">None</button>
                            <button class="option-btn" data-mark="freckles" data-action="update-character" data-field="facialMarking" data-value="freckles">Freckles</button>
                            <button class="option-btn" data-mark="scar" data-action="update-character" data-field="facialMarking" data-value="scar">Scar</button>
                            <button class="option-btn" data-mark="tattoo" data-action="update-character" data-field="facialMarking" data-value="tattoo">Tattoo</button>
                        </div>
                    </div>
                </div>

                <!-- Accessories -->
                <div class="custom-section">
                    <div class="section-title">Accessories</div>

                    <div class="form-group">
                        <label>Glasses</label>
                        <div class="option-grid">
                            <button class="option-btn active" data-glasses="none" data-action="update-character" data-field="glasses" data-value="none">None</button>
                            <button class="option-btn" data-glasses="round" data-action="update-character" data-field="glasses" data-value="round">Round</button>
                            <button class="option-btn" data-glasses="cat" data-action="update-character" data-field="glasses" data-value="cat">Cat Eye</button>
                            <button class="option-btn" data-glasses="shades" data-action="update-character" data-field="glasses" data-value="shades">Shades</button>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Hat</label>
                        <div class="option-grid">
                            <button class="option-btn active" data-hat="none" data-action="update-character" data-field="hat" data-value="none">None</button>
                            <button class="option-btn" data-hat="cap" data-action="update-character" data-field="hat" data-value="cap">Cap</button>
                            <button class="option-btn" data-hat="hood" data-action="update-character" data-field="hat" data-value="hood">Hood</button>
                            <button class="option-btn" data-hat="crown" data-action="update-character" data-field="hat" data-value="crown">Crown</button>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Cape</label>
                        <div class="option-grid">
                            <button class="option-btn active" data-cape="none" data-action="update-character" data-field="cape" data-value="none">None</button>
                            <button class="option-btn" data-cape="short" data-action="update-character" data-field="cape" data-value="short">Short</button>
                            <button class="option-btn" data-cape="long" data-action="update-character" data-field="cape" data-value="long">Long</button>
                            <button class="option-btn" data-cape="royal" data-action="update-character" data-field="cape" data-value="royal">Royal</button>
                        </div>
                    </div>
                </div>

                <!-- Clothing -->
                <div class="custom-section">
                    <div class="section-title">Clothing & Armor</div>

                    <div class="form-group">
                        <label>Outfit Style</label>
                        <div class="option-grid">
                            <button class="option-btn active" data-outfit="casual" data-action="update-character" data-field="outfitStyle" data-value="casual">Casual</button>
                            <button class="option-btn" data-outfit="military" data-action="update-character" data-field="outfitStyle" data-value="military">Military</button>
                            <button class="option-btn" data-outfit="fantasy" data-action="update-character" data-field="outfitStyle" data-value="fantasy">Fantasy</button>
                            <button class="option-btn" data-outfit="cyberpunk" data-action="update-character" data-field="outfitStyle" data-value="cyberpunk">Cyberpunk</button>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Shoe Type</label>
                        <div class="option-grid">
                            <button class="option-btn active" data-shoes="casual" data-action="update-character" data-field="shoes" data-value="casual">Casual</button>
                            <button class="option-btn" data-shoes="boots" data-action="update-character" data-field="shoes" data-value="boots">Boots</button>
                            <button class="option-btn" data-shoes="heels" data-action="update-character" data-field="shoes" data-value="heels">Heels</button>
                            <button class="option-btn" data-shoes="sandals" data-action="update-character" data-field="shoes" data-value="sandals">Sandals</button>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Armor Type</label>
                        <div class="option-grid">
                            <button class="option-btn" data-armor="none" data-action="update-character" data-field="armor" data-value="none">None</button>
                            <button class="option-btn" data-armor="light" data-action="update-character" data-field="armor" data-value="light">Light</button>
                            <button class="option-btn active" data-armor="medium" data-action="update-character" data-field="armor" data-value="medium">Medium</button>
                            <button class="option-btn" data-armor="heavy" data-action="update-character" data-field="armor" data-value="heavy">Heavy</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right: Character Info & Actions -->
            <div class="character-name-panel">
                <div class="panel-title">Character Information</div>

                <div class="name-input-group">
                    <label>Character Name</label>
                    <input type="text" id="characterName" placeholder="Enter character name..." maxlength="30">
                </div>

                <div class="character-class">
                    <label>Class (Future)</label>
                    <select id="characterClass">
                        <option value="warrior">Warrior</option>
                        <option value="mage">Mage</option>
                        <option value="rogue">Rogue</option>
                        <option value="paladin">Paladin</option>
                        <option value="ranger">Ranger</option>
                    </select>
                </div>

                <div class="stats-grid">
                    <div class="stat-box">
                        <div class="stat-name">Strength</div>
                        <div class="stat-value">10</div>
                    </div>
                    <div class="stat-box">
                        <div class="stat-name">Agility</div>
                        <div class="stat-value">10</div>
                    </div>
                    <div class="stat-box">
                        <div class="stat-name">Intelligence</div>
                        <div class="stat-value">10</div>
                    </div>
                    <div class="stat-box">
                        <div class="stat-name">Endurance</div>
                        <div class="stat-value">10</div>
                    </div>
                </div>

                <div class="section-divider"></div>

                <div class="action-buttons">
                    <button class="btn btn-secondary" data-action="reset-character">Reset</button>
                    <button class="btn btn-secondary" data-action="randomize-character">Random</button>
                    <button class="btn btn-primary btn-full" data-action="save-character">Save Character</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Success Modal -->
    <div class="modal" id="successModal">
        <div class="modal-content">
            <h2>♥ Character Saved! ♥</h2>
            <p id="successMessage">Your character has been successfully saved to your account.</p>
            <div class="modal-buttons">
                <button class="btn btn-secondary" data-action="close-modal" data-modal-id="successModal">Edit More</button>
                <button class="btn btn-primary" data-action="go-dashboard">Go to Dashboard</button>
            </div>
        </div>
    </div>

    <script src="../../assets/js/character-creator.js"></script>
</body>
</html>


