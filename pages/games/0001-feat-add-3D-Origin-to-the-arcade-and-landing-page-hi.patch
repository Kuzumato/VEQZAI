+.sl{height:62px;background:rgba(255,255,255,.08);border-radius:6px;display:flex;flex-direction:column;align-items:center;justify-content:center;font-size:22px;cursor:pointer;text-align:center;line-height:1.1}
+.sl small{font-size:10px;opacity:.85}
+#dlg{position:fixed;left:50%;top:50%;transform:translate(-50%,-50%);background:var(--pn);padding:14px 16px;border-radius:8px;width:min(440px,92vw);display:none;max-height:70vh;overflow:auto;font-size:14px}
+.rw{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:7px 0;border-top:1px solid rgba(255,255,255,.12)}
+.rw button{background:#e6b422;color:#1a1a1a;border:0;border-radius:5px;padding:6px 12px;font-weight:bold;cursor:pointer;min-width:62px}
+.rw button:disabled{background:#555;color:#bbb;cursor:default}
+#boss{position:fixed;left:50%;top:calc(14px + env(safe-area-inset-top,0px));transform:translateX(-50%);width:min(360px,56vw);display:none;text-align:center;pointer-events:none;text-shadow:0 1px 3px #000}
+#bb{height:12px;background:#3a2326;border-radius:6px;overflow:hidden;margin-top:3px}#bf{height:100%;background:#e6b422;width:100%}
+#mm{width:150px;height:150px;position:fixed;right:12px;bottom:calc(14px + env(safe-area-inset-bottom,0px));border-radius:8px;border:2px solid rgba(255,255,255,.25);pointer-events:none}
+#xh{position:fixed;left:50%;top:50%;width:8px;height:8px;margin:-4px 0 0 -4px;border:2px solid #fff;border-radius:50%;opacity:.8;display:none;pointer-events:none}
+#spd{position:fixed;inset:0;pointer-events:none;opacity:0;transition:opacity .25s;background:radial-gradient(ellipse at center,rgba(255,255,255,0) 55%,rgba(255,255,255,.35) 100%)}
+#hud,#stats,#msg,#inv,#dlg{backdrop-filter:blur(6px);border:1px solid rgba(255,255,255,.14);box-shadow:0 4px 18px rgba(0,0,0,.35)}
+#stats #hpf{background:linear-gradient(90deg,#b03024,#ff6b5a);transition:width .25s}
+#stats #xpf{background:linear-gradient(90deg,#c99410,#ffe066);transition:width .25s}
+#stx{font-weight:bold;letter-spacing:.02em}
+#vig{position:fixed;inset:0;pointer-events:none;background:radial-gradient(ellipse at center,rgba(0,0,0,0) 62%,rgba(0,0,0,.3) 100%)}
+#help a{pointer-events:auto;color:#6fd3ff;text-decoration:none;font-weight:600}
+#help a:hover{text-decoration:underline}
+#hpb{height:12px;background:#3a2326;border-radius:6px;overflow:hidden;margin-bottom:6px}#hpf{height:100%;background:#d9534f;width:100%}#msg{position:fixed;left:50%;bottom:90px;transform:translateX(-50%);background:var(--pn);padding:8px 16px;border-radius:6px;opacity:0;transition:opacity .3s;pointer-events:none;font-size:15px}
+#load{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;background:var(--bg);font-size:20px}
+</style></head><body>
+<div id="hud"><button id="bm" aria-label="Controls menu">☰</button> <b>3D ORIGIN</b><div id="help">WASD move · Shift run · Space jump · F attack · I bag · H potion · R sell<br>1 sword · 2 bow · T talk · B arrows · M sound · V view · Y gravity<br>Hold Space against walls to climb<br>Auto-saves · K twice erases save<br>Drag to look · Scroll to zoom · Q/E turn<br>C opens or closes this menu<br><a href="../dashboard/arcade-dashboard.html">&larr; Back to Arcade</a></div></div>
+<div id="stats"><div id="hpb"><div id="hpf"></div></div><div id="xpb"><div id="xpf"></div></div><div id="stx"></div></div><div id="msg"></div><div id="spd"></div><div id="vig"></div><div id="xh"></div><div id="dlg"><b id="dt"></b> <small>(T or Esc to close)</small><div id="dl"></div></div><div id="boss"><div id="bn">Slime King</div><div id="bb"><div id="bf"></div></div></div><canvas id="mm" width="140" height="140"></canvas><div id="inv"><b>Inventory</b> <small>(I to close · click a potion to drink)</small><div id="eqp" style="margin-top:6px;font-size:13px"></div><div id="slots"></div></div>
+<div id="load">Building the village…</div>
+<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
+<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/loaders/GLTFLoader.js"></script>
+<script>
+const S=3,B64={"wall": "", "wall-door": "", "wall-window-small": "", "wall-wood": "", "wall-wood-door": "", "wall-wood-window-small": "", "roof-gable": "", "roof-point": "", "road": "", "fountain-round": "", "tree": "", "tree-high": "", "tree-crooked": "", "tree-high-round": "", "rock-large": "", "rock-small": "", "rock-wide": "", "stall-red": "", "stall-green": "", "lantern": "", "cart": "", "fence": "", "fence-gate": "", "hedge": "", "chimney": "", "banner-red": "", "banner-green": "", "windmill": "", "watermill": ""};
+const scene=new THREE.Scene();scene.background=new THREE.Color(0x9fd3f0);scene.fog=new THREE.Fog(0x9fd3f0,60,150);
+const R=new THREE.WebGLRenderer({antialias:true});R.setPixelRatio(Math.min(devicePixelRatio,2));R.shadowMap.enabled=true;R.outputEncoding=THREE.sRGBEncoding;R.toneMapping=THREE.ACESFilmicToneMapping;R.toneMappingExposure=1.25;R.shadowMap.type=THREE.PCFSoftShadowMap;document.body.appendChild(R.domElement);
+const cam=new THREE.PerspectiveCamera(60,1,.1,220);
+const hemi=new THREE.HemisphereLight(0xffffff,0x7a8a60,.6);scene.add(hemi);
+const sun=new THREE.DirectionalLight(0xfff1d0,.75);sun.position.set(30,50,20);sun.castShadow=true;sun.shadow.mapSize.set(2048,2048);sun.shadow.bias=-.0004;sun.shadow.normalBias=.4;
+const sc=sun.shadow.camera;sc.left=sc.bottom=-36;sc.right=sc.top=36;sc.far=150;scene.add(sun,sun.target);
+const ground=new THREE.Mesh(new THREE.PlaneGeometry(500,500),new THREE.MeshStandardMaterial({color:0x4f8f36}));
+ground.rotation.x=-Math.PI/2;ground.position.y=-.01;ground.receiveShadow=true;scene.add(ground);
+
+const M={},bad=[],L=new THREE.GLTFLoader();window.createImageBitmap=undefined;const TX=new THREE.DataTexture(Uint8Array.from(atob(''),c=>c.charCodeAt(0)),256,256,THREE.RGBAFormat);TX.generateMipmaps=true;TX.needsUpdate=true;THREE.TextureLoader.prototype.load=function(u,ok){setTimeout(()=>ok&&ok(TX),0);return TX};
+const b2a=s=>{const b=atob(s),a=new Uint8Array(b.length);for(let i=0;i<b.length;i++)a[i]=b.charCodeAt(i);return a.buffer};
+Promise.all(Object.keys(B64).map(k=>new Promise(r=>L.parse(b2a(B64[k]),'',g=>{M[k]=g.scene;r()},()=>{bad.push(k);r()})))).then(()=>{try{build();if(bad.length)document.getElementById('hud').insertAdjacentHTML('beforeend','<br>Failed to load: '+bad.join(', '))}catch(e){console.error(e);document.getElementById('hud').insertAdjacentHTML('beforeend','<br>Error: '+e.message);document.getElementById('load').remove();loop()}});
+
+const boxes=[],circles=[],spin=[],LAMPS=[];
+function put(n,x,z,o={}){if(!M[n])return;if(n==='lantern')LAMPS.push([x,z]);const s=o.s||S,m=M[n].clone();
+ m.scale.set(s*(o.sx||1),s*(o.sy||1),s*(o.sz||1));m.position.set(x,o.y||0,z);m.rotation.y=o.ry||0;
+ m.traverse(c=>{if(c.isMesh)c.castShadow=c.receiveShadow=true});scene.add(m);return m}
+const ang=(dx,dz)=>Math.atan2(-dz,dx);
+
+function house(i0,j0,W,D,front,wood,L=1){
+ const p=wood?'wall-wood':'wall',ev=wood?0xc8743f:0xb9b5d8;
+ for(let l=0;l<L;l++)for(let i=0;i<W;i++)for(let j=0;j<D;j++){
+  const X=(i0+i)*S,Z=(j0+j)*S,sd=[];
+  if(i==0)sd.push([-1,0]);if(i==W-1)sd.push([1,0]);if(j==0)sd.push([0,-1]);if(j==D-1)sd.push([0,1]);
+  for(const[dx,dz]of sd){let n=p,ban=0;
+   if(dz===front){if(W>=5&&(i==1||i==W-2))ban=i==1?'banner-red':'banner-green';
+    else n=l==0&&i===W>>1?p+'-door':p+'-window-small'}
+   else if(dz===-front&&i%2)n=p+'-window-small';
+   else if(dx&&l&&j==D>>1)n=p+'-window-small';
+   put(n,X,Z,{y:l*S,ry:ang(dx,dz)});if(n.indexOf('window')>0)wglow(X,Z,dx,dz,l);
+   if(ban&&l==0)put(ban,X+dx*.1*S+dz*0,Z+dz*.1*S,{ry:ang(dx,dz)})}}
+ const x0=(i0-.5)*S,x1=(i0+W-.5)*S,z0=(j0-.5)*S,z1=(j0+D-.5)*S,zc=(z0+z1)/2,H=S*L;
+ const fl=new THREE.Mesh(new THREE.BoxGeometry(x1-x0,.1,z1-z0),new THREE.MeshStandardMaterial({color:0x7a5a3a}));
+ fl.position.set((x0+x1)/2,.05,zc);fl.receiveShadow=true;scene.add(fl);
+ for(let i=0;i<W;i++)put('roof-gable',(i0+i)*S,zc,{y:H,sz:D,sy:1.15});
+ const h=H+S*.57*1.15,mat=new THREE.MeshStandardMaterial({color:ev,side:THREE.DoubleSide});
+ for(const x of[x0+.05,x1-.05]){const g=new THREE.BufferGeometry();
+  g.setAttribute('position',new THREE.Float32BufferAttribute([x,H,z0,x,H,z1,x,h,zc],3));g.computeVertexNormals();
+  const m=new THREE.Mesh(g,mat);m.castShadow=true;scene.add(m)}
+ put('chimney',x1-1.3*S-.32*S,zc+D*S*.25,{y:H+.2*S,sy:1.15});
+ const jy=(front>0?j0+D-1:j0)+front;
+ for(let i=0;i<W;i++){const X=(i0+i)*S,Z=jy*S,g=i===W>>1;
+  put(g?'fence-gate':'fence',X,Z,{ry:ang(0,front)});
+  if(!g){const f=Z+front*1.4;boxes.push([X-1.5,X+1.5,f-.25,f+.25,1.1])}}
+ boxes.push([x0,x1,z0,z1,H+1.2])}
+
+function build(){
+ // roads
+ const rd=new Set(),add=(i,j)=>rd.add(i+','+j);
+ for(let i=-2;i<=2;i++)for(let j=-2;j<=2;j++)add(i,j);
+ for(let i=-11;i<=11;i++)add(i,0);
+ for(let j=-5;j<=14;j++)add(0,j);
+ rd.forEach(k=>{const[i,j]=k.split(',').map(Number);put('road',i*S,j*S)});
+ // houses: i0,j0,W,D,front,wood
+ [[-10,-3,3,2,1,0],[-6,-3,3,2,1,1,2],[4,-3,3,2,1,1],[8,-3,3,2,1,0],
+  [-10,2,3,2,-1,1],[-6,2,3,2,-1,0],[4,2,3,2,-1,0,2],[8,2,3,2,-1,1],[-2,-9,5,3,1,1,2]].forEach(h=>house(...h));
+ // fountain + stalls + props
+ put('fountain-round',0,0);circles.push([0,0,2.9,1.1]);
+ [[-2,-2,'stall-red'],[2,-2,'stall-green'],[2,2,'stall-red'],[-2,2,'stall-green']].forEach(([i,j,n])=>{
+  put(n,i*S,j*S,{ry:ang(-i,-j)});boxes.push([i*S-1.3,i*S+1.3,j*S-1.3,j*S+1.3,1.5])});
+ put('cart',-4.5*S,1.1*S,{ry:.6});circles.push([-4.5*S,1.1*S,1.6,1.4]);
+ [-8,-4,4,8].forEach(i=>[-1,1].forEach(s=>{const x=i*S,z=s*(.5*S+.6);put('lantern',x,z);circles.push([x,z,.35])}));
+ [-1,1].forEach(s=>{put('lantern',s*(.5*S+.6),5.5*S);circles.push([s*(.5*S+.6),5.5*S,.35])});
+// hedged entrance, windmill tower, watermill
+ for(let j=6;j<=10;j++){put('hedge',S,j*S,{ry:Math.PI});put('hedge',-S,j*S,{});
+  boxes.push([1.5,2.3,(j-.5)*S,(j+.5)*S,.8],[-2.3,-1.5,(j-.5)*S,(j+.5)*S,.8])}
+ (i0=>{const j0=-8;
+  for(let l=0;l<3;l++)for(let i=0;i<2;i++)for(let j=0;j<2;j++){const X=(i0+i)*S,Z=(j0+j)*S;
+   for(const[dx,dz]of[[i?1:-1,0],[0,j?1:-1]])put(l==0&&dz==1&&i==1?'wall-door':l==1?'wall-window-small':'wall',X,Z,{y:l*S,ry:ang(dx,dz)})}
+  put('roof-point',(i0+.5)*S,(j0+.5)*S,{y:3*S,sx:2.1,sz:2.1,sy:3.2});
+  const g=new THREE.Group();g.position.set((i0+.5)*S,2.3*S,(j0+1.5)*S+.3*S*1.4);g.rotation.y=Math.PI/2;
+  const w=put('windmill',0,0,{s:S*1.4});scene.remove(w);g.add(w);scene.add(g);spin.push(w);
+  boxes.push([(i0-.5)*S,(i0+1.5)*S,(j0-.5)*S,(j0+1.5)*S,9])})(-9);
+ {const sc=S*.9,x=-10.5*S-.43*sc,z=-2.5*S,w=put('watermill',x,z,{s:sc,y:2});spin.push(w);
+  const pd=new THREE.Mesh(new THREE.BoxGeometry(3.2,.12,6.4),new THREE.MeshStandardMaterial({color:0x4aa3d8,roughness:.2}));
+  pd.position.set(x-.2,.06,z);pd.receiveShadow=true;scene.add(pd);boxes.push([x-1.6,x+1.4,z-3.2,z+3.2])}
+ // forest + rocks
+ const rnd=(a=>()=>{a|=0;a=a+0x6D2B79F5|0;let t=Math.imul(a^a>>>15,1|a);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296})(7);
+ const T=['tree','tree-high','tree-crooked','tree-high-round'],RK=['rock-large','rock-small','rock-wide'];
+// ---- detail places: farm, tavern, forge, well, park, campfire, training yard ----
+ {const MT=(c,e)=>new THREE.MeshStandardMaterial({color:c,roughness:.85,emissive:e||0});
+ const bxm=(x,y,z,w,h,d,c,e)=>{const m=new THREE.Mesh(new THREE.BoxGeometry(w,h,d),MT(c,e));m.position.set(x,y+h/2,z);m.castShadow=m.receiveShadow=true;scene.add(m);return m};
+ const cyl=(x,y,z,r,h,c,rs,e)=>{const m=new THREE.Mesh(new THREE.CylinderGeometry(r,r,h,rs||10),MT(c,e));m.position.set(x,y+h/2,z);m.castShadow=m.receiveShadow=true;scene.add(m);return m};
+ const sph=(x,y,z,r,c)=>{const m=new THREE.Mesh(new THREE.SphereGeometry(r,10,8),MT(c));m.position.set(x,y,z);m.castShadow=true;scene.add(m);return m};
+ const lab=(s,x,y,z)=>{const l=label(s);l.position.set(x,y,z);l.scale.set(4.5,1.1,1);scene.add(l)};
