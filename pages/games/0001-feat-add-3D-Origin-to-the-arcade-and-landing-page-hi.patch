diff --git a/assets/css/index.css b/assets/css/index.css
index 8e98b0a..af330eb 100644
--- a/assets/css/index.css
+++ b/assets/css/index.css
@@ -281,6 +281,9 @@ section { padding: 120px 48px; }
 .game-purple { background: linear-gradient(135deg, #1a0a2e 0%, #11111a 100%); }
